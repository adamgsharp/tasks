# Get your API key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (default: claude-sonnet-4-6)
# CLAUDE_MODEL=claude-opus-4-8

# --- Write-back to the Obsidian vault (optional but recommended) ---
# When these are set, the app reads brain files live from GitHub AND can
# write captures / filed tasks back to them. Leave unset for read-only mode.
#
# A fine-grained Personal Access Token with Contents: Read and write,
# scoped to just this repo: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=github_pat_...
# owner/name of the repo holding the brain/ files
GITHUB_REPO=adamgsharp/tasks
# The branch the app reads/writes (the one Vercel deploys & Obsidian syncs)
GITHUB_BRANCH=main
